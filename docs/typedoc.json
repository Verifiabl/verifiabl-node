{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../src/index.ts"],
  "tsconfig": "../tsconfig.json",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableGit": true,
  "disableSources": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": false,
    "invalidLink": false
  }
}
