{
  "name": "@verifiabl/issuer",
  "version": "0.24.0",
  "description": "Official Verifiabl Node.js SDK for issuing payslip QR codes, formatting PII, AES-256-GCM encryption helpers, and typed issuer API calls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verifiabl/verifiabl-node.git"
  },
  "homepage": "https://verifiabl.io",
  "keywords": [
    "verifiabl",
    "payslip",
    "issuer",
    "qr-code",
    "sdk"
  ],
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --globals",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm check:exports",
    "check:exports": "attw --pack ."
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "pngjs": "^7.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zxing-wasm": "3.1.4"
  }
}
